{
	"name": "escaping-flatland",
	"version": "0.0.1",
	"private": true,
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "npm run test:integration && npm run test:unit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.81.0",
		"@number-flow/svelte": "^0.4.2",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/adapter-netlify": "^7.1.0",
		"@sveltejs/adapter-node": "^6.0.6",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@tweenjs/tween.js": "^25.0.0",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.19.4",
		"@types/three": "^0.187.0",
		"bits-ui": "^2.22.0",
		"dotenv": "^18.0.10",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"sparse-octree": "^7.3.0",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"three": "^0.187.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.2"
	},
	"type": "module"
}
